# Multi-stage secure build for Predictive Optimization Controller
FROM golang:alpine AS builder

WORKDIR /workspace

RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY internal/ internal/
COPY cmd/ cmd/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -ldflags="-w -s" -o /controller ./cmd/controller

FROM gcr.io/distroless/static:nonroot

WORKDIR /

COPY --from=builder /controller /controller

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/controller"]
