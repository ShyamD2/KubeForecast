# Multi-stage secure build for Custom Predictive Scheduler
FROM golang:1.24-alpine AS builder

WORKDIR /workspace

RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY internal/ internal/
COPY cmd/ cmd/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -ldflags="-w -s" -o /scheduler-plugin ./cmd/scheduler-plugin

FROM gcr.io/distroless/static:nonroot

WORKDIR /

COPY --from=builder /scheduler-plugin /scheduler-plugin

USER 65532:65532

EXPOSE 10259

ENTRYPOINT ["/scheduler-plugin"]
